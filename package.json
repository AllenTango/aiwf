{
  "name": "ai-dev-workflow-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action + CLI that runs an AI-native dev team: captain plans, parallel members implement, captain synthesizes the PR.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @aiwf/core build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
